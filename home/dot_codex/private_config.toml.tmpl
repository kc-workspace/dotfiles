{{- $app_resource := "/Applications/ChatGPT.app/Contents/Resources" -}}

{{- includeTemplate "featureFlags/helpers/mustEnable" (dict
  "flag" "ai::codex:enable"
  "context" $
) -}}

#:schema https://developers.openai.com/codex/config-schema.json

## https://developers.openai.com/codex/config-reference

approval_policy        = "on-request"
file_opener            = "vscode-insiders"
model                  = "gpt-5.6-sol"
model_reasoning_effort = "medium"
personality            = "pragmatic"
service_tier           = "default"

notify = ["{{ .chezmoi.homeDir }}/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended"]

[history]
max_bytes   = 5000000    ## 5 MB
persistence = "save-all"

[feedback]
enabled = false

[mcp_servers.context7]
command = "mise"
args    = ["exec", "npm:@upstash/context7-mcp", "--", "context7-mcp"]

[mcp_servers.memory]
command = "mise"
args = [
  "exec",
  "npm:@modelcontextprotocol/server-memory",
  "--",
  "mcp-server-memory",
]

[mcp_servers.sequential-thinking]
command = "mise"
args = [
  "exec",
  "npm:@modelcontextprotocol/server-sequential-thinking",
  "--",
  "mcp-server-sequential-thinking",
]

[mcp_servers.svelte]
url = "https://mcp.svelte.dev/mcp"

{{- if includeTemplate "global/helpers/isDarwin" $ }}

[mcp_servers.node_repl]
args = []
command = "{{ $app_resource }}/cua_node/bin/node_repl"
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
CODEX_HOME = "{{ .chezmoi.homeDir }}/.codex"
CODEX_CLI_PATH = "{{ $app_resource }}/codex"
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "{{ $app_resource }}/cua_node/lib/node_modules"
NODE_REPL_NODE_PATH = "{{ $app_resource }}/cua_node/bin/node"
NODE_REPL_TRUSTED_CODE_PATHS = "{{ .chezmoi.homeDir }}/.codex:{{ $app_resource }}/cua_node/lib/node_modules"
NODE_REPL_TRUSTED_SERVICES = '{"browser":"{{ .chezmoi.homeDir }}/.codex/plugins/cache/openai-bundled/browser/26.908.40834/scripts/browser-service.mjs","sky":"@oai/sky/service"}'
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE = ""
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab"
BROWSER_USE_TINYSKY_ENABLED = "1"
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.908.40834"
SKY_CUA_SERVICE_PATH = "{{ .chezmoi.homeDir }}/.codex/computer-use/Codex Computer Use.app"

[mcp_servers.computer-use]
command = "./Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
args = ["mcp"]
cwd = "."
enabled = false
{{- end }}

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."browser-use@openai-bundled"]
enabled = true

[plugins."google-calendar@openai-curated"]
enabled = true

[plugins."gmail@openai-curated"]
enabled = true

[plugins."github@openai-curated"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[marketplaces.openai-bundled]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.codex/.tmp/bundled-marketplaces/openai-bundled"

[marketplaces.openai-primary-runtime]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.cache/codex-runtimes/codex-primary-runtime/plugins/openai-primary-runtime"

[features]
memories = true
js_repl  = true

[desktop]
conversationDetailMode      = "STEPS_PROSE"
ambient-suggestions-enabled = false
mac-menu-bar-enabled        = false
show-context-window-usage   = true
sansFontSize                = 14
codeFontSize                = 13
followUpQueueMode           = "queue"
