[tools]
1password-cli = "2.41.1"   ## For password management
age           = "1.3.2"    ## For file encryption
bun           = "1.4.3"
github-cli    = "2.103.0"
go            = "1.27.3"   ## For golang runtime
jq            = "1.8.2"
neovim        = "0.12.6"   ## For terminal editor
node          = "24.18.0"  ## For node runtime
python        = "3.15.1"   ## For python runtime
rust          = "1.99.1"
yq            = "4.54.1"
chezmoi       = "2.73.3"   ## For dotfiles management
usage         = "5.0.0"    ## Required by `mise completion`
uv            = "0.13.5"
dotnet        = "10.0.402" ## For dotnot runtime

[tool_alias]
cloc           = "github:AlDanial/cloc"
forgecode      = "github:tailcallhq/forgecode"
playwright-cli = "npm:@playwright/cli"
promptfoo      = "npm:promptfoo"
skills         = "npm:skills"
codex          = "npm:@openai/codex"

[settings]
disable_backends                    = ["spm", "gem", "ubi", "asdf"]
not_found_auto_install              = true
pin                                 = true
idiomatic_version_file_enable_tools = ["node", "bun", "pnpm", "yarn"] ## https://mise.jdx.dev/configuration.html#idiomatic-version-files
experimental                        = true

[settings.status]
show_env      = true
show_tools    = true
truncate      = false
{{- if includeTemplate "global/helpers/isMachine" $ }}
missing_tools = "always"
{{- end }}

[settings.npm]
package_manager = "bun"

[settings.node]
{{- includeTemplate "featureFlags/helpers/include" (dict
  "flag" "mise::node:unofficial-builds"
  "beforeLine" 1
  "afterLine" 0
  "context" $
) }}

[settings.pipx]
uvx = true

[settings.dotnet]
cli_telemetry_optout = true
isolated             = true

