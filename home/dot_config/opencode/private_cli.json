{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "single": false
  },
  "attention": {
    "notifications": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
