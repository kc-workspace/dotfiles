{{- includeTemplate "featureFlags/helpers/mustEnable" (dict
  "flag" "ai::copilot:enable"
  "context" $
) -}}
{
  "renderMarkdown": true,
  "theme": "auto",
  "model": "gpt-5.6-luna",
  "includeCoAuthoredBy": false,
  "showTipsOnStartup": false,
  "updateTerminalTitle": true,
  "footer": {
    "showModelEffort": false,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showYolo": false,
    "showCustom": false
  },
  "allowedUrls": [
    "https://docs.github.com"
  ],
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "context7@context7-marketplace": true,
    "superpowers@superpowers-marketplace": true
  }
}
